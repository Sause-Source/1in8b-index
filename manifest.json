{
    "manifest_version": 3 ,
    "name": "1in8b パラメータ指数拡張機能",
    "version": "1.0.0",
    "description": "1in8b.lifeで各パラメータの平均値を算出して可視化する拡張機能です。",
    "icons": {
        "16": "heart16.png",
        "48": "heart48.png",
        "128": "heart128.png"
    },
    "content_scripts": [
    {
        "matches": ["https://1in8b.life/*"],
        "css": ["style.css"],
        "js": ["content.js"],
        "run_at": "document_idle",
        "world": "MAIN"
    }
    ]
}